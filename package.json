{
  "name": "form-and-roar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-pages.js",
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/generate-pages.js && vite build && node scripts/finalize-build.js",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node scripts/run-browser-tests.js",
    "pretest": "npm run export:html",
    "export:html": "node scripts/export-standalone.js",
    "catalog:import": "node scripts/import-catalog.js",
    "firebase:deploy": "npm run build && firebase deploy --only hosting,firestore:rules",
    "test:rules": "firebase emulators:exec --project demo-form-and-roar --only firestore \"node --test tests-rules/firestore.test.js\"",
    "test:hosting": "firebase emulators:exec --project demo-form-and-roar --only hosting \"node --test tests-rules/hosting.test.js\""
  },
  "dependencies": {
    "firebase": "13.2.0",
    "font-awesome": "4.7.0",
    "grapesjs": "0.22.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.56.1",
    "firebase-tools": "15.35.0",
    "vite": "7.3.7"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
