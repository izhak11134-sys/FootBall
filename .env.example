# Copy only the public Web app values from Firebase Project settings.
# Do not add a Service Account, private key or Gmail password.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Set the actual HTTPS hosting origin after deployment, e.g. https://YOUR_PROJECT_ID.web.app
SITE_URL=
# Keep false while the catalogue contains only design previews.
SITE_INDEXABLE=false
