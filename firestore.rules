rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner() {
      return signedIn() && request.auth.uid == 'qIjs6PlvVATYYAbcprHopz5OYZG3';
    }
    function validProduct(p, id) {
      return p is map
        && p.keys().hasAll(['id','name','category','description','image','status','retailer','url','markets','price','currency','priceCheckedAt','rightsConfirmed'])
        && p.keys().hasOnly(['id','name','category','description','image','status','retailer','url','markets','price','currency','priceCheckedAt','rightsConfirmed'])
        && id.matches('^[a-z0-9][a-z0-9-]{0,59}$') && p.id == id
        && p.name is string && p.name.size() > 0 && p.name.size() <= 100
        && p.category in ['shirts','retro','fanwear','collectibles','gifts']
        && p.status in ['preview','active']
        && p.description is string && p.description.size() <= 500
        && p.image is string && p.image.size() <= 2048
        && (p.image.matches('^/images/[a-z0-9-]+[.]svg$') || p.image.matches('^https://[a-zA-Z0-9.-]+(:[0-9]+)?([/?#].*)?$'))
        && p.retailer is string && p.retailer.size() <= 100
        && p.url is string && p.url.size() <= 4096
        && (p.url == '' || p.url.matches('^https://[a-zA-Z0-9.-]+(:[0-9]+)?([/?#].*)?$'))
        && p.markets is list && p.markets.size() <= 44
        && p.markets.hasOnly(['GB','AT','BE','BG','HR','CY','CZ','DK','EE','FI','FR','DE','GR','HU','IS','IE','IT','LV','LI','LT','LU','MT','NL','NO','PL','PT','RO','SK','SI','ES','SE','CH','AL','AD','BA','MC','ME','MK','SM','RS','UA','MD','TR','XK'])
        && p.currency in ['GBP','EUR','CHF','SEK','NOK','DKK','PLN','CZK','HUF','RON']
        && p.priceCheckedAt is string
        && (p.price == null || (p.price is number && p.price > 0 && p.priceCheckedAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && p.rightsConfirmed is bool
        && (p.status != 'active' || (p.url != '' && p.retailer.size() > 0 && p.markets.size() > 0 && p.rightsConfirmed == true));
    }
    function validRecord(id) {
      let d = request.resource.data;
      return d.keys().hasAll(['product','position','published','revision','createdAt','updatedAt','updatedBy'])
        && d.keys().hasOnly(['product','position','published','revision','createdAt','updatedAt','updatedBy'])
        && validProduct(d.product, id)
        && d.position is int && d.position >= 0 && d.position <= 200000
        && d.published is bool && (!d.published || d.product.status == 'active')
        && d.revision is int && d.revision > 0
        && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
    }
    match /catalogAdmins/{uid} {
      allow read, write: if false;
    }
    match /catalogProducts/{id} {
      allow read: if owner() || resource.data.published == true;
      allow create: if owner() && validRecord(id) && request.resource.data.createdAt == request.time && request.resource.data.revision == 1;
      allow update: if owner() && validRecord(id)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if owner();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
